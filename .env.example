# ============================================================
# Credentials
# ============================================================

OPENAI_API_KEY=
DISCORD_TOKEN=


# ============================================================
# Host-side data directories
#
# These paths exist on the Docker host.
# They are bind-mounted into the containers.
# Use absolute paths.
# ============================================================

HOST_OCR_DIR=/data/sw2.5/ocr

HOST_VECTOR_INDEX_DIR=/data/sw2.5/vector_index

HOST_BOOK_DIR=/data/sw2.5/book_info

HOST_PDF_DIR=/data/sw2.5/pdf

HOST_IMAGE_DIR=/data/sw2.5/image


# ============================================================
# Published host ports
#
# These are ports exposed on the Docker host.
#
# Docker internal ports remain fixed:
#
#   api    -> 8000
#   ui     -> 8501
#   pdfjs  -> 80
#
# Example:
#
#   host:4001 -> ui:8501
#   host:4080 -> pdfjs:80
# ============================================================

HOST_UI_PORT=4001

HOST_PDFJS_PORT=4080


# ============================================================
# Public URLs
#
# These URLs are embedded in responses returned to browsers
# and Discord users.
#
# Do NOT use localhost here for production access from
# another PC or from Discord.
# ============================================================

PDFJS_BASE_URL=http://localhost:4080/pdfjs/web/viewer.html

IMAGE_BASE_URL=http://localhost:4080/image


# ============================================================
# PDF.js
# ============================================================

PDFJS_VERSION=5.1.91

# ============================================================
# OpenAI models
# ============================================================

EMBEDDING_MODEL=text-embedding-3-small